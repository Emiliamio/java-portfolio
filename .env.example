# ============================================
# 环境变量模板
# 复制此文件为 .env，然后填入真实值
# cp .env.example .env
# ============================================

# MySQL root 密码
MYSQL_ROOT_PASSWORD=root123456

# 大模型 API Key（项目三需要）
# Anthropic:  https://console.anthropic.com/
# DeepSeek:   https://platform.deepseek.com/  (OpenAI 兼容，国内可用)
AI_API_KEY=sk-ant-your-key-here

# 大模型 API 地址（可选）
# Anthropic 默认: https://api.anthropic.com/v1/messages
# DeepSeek:       https://api.deepseek.com/v1/chat/completions
AI_API_URL=https://api.anthropic.com/v1/messages

# 模型名称（可选）
# Anthropic: claude-sonnet-5
# DeepSeek:  deepseek-chat
AI_MODEL=claude-sonnet-5

# ─── 企业级分布式与私有化扩展配置 (可选) ───
# Kafka 分布式流式摄取削峰 (docker compose --profile enterprise 模式)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=audit.logs.raw

# ClickHouse 列式 OLAP 45x 毫秒直方图引擎
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123/default

# Ollama 本地私有化大模型 (100% 本地离线私有化)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
