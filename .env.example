# ============================================
# 环境变量模板
# 复制此文件为 .env，然后填入真实值
# cp .env.example .env
# ============================================

# MySQL root 密码
MYSQL_ROOT_PASSWORD=root123456

# 大模型 API Key（项目三需要）
# 从 https://console.anthropic.com/ 获取
AI_API_KEY=sk-ant-your-key-here

# 大模型 API 地址（可选，默认 Anthropic）
AI_API_URL=https://api.anthropic.com/v1/messages

# 模型名称（可选）
AI_MODEL=claude-sonnet-5-20251001
