# ============================================
# 环境变量模板
# 复制此文件为 .env，然后填入真实值
# cp .env.example .env
# ============================================

# MySQL root 密码
MYSQL_ROOT_PASSWORD=root123456

# 大模型 API Key（项目三需要）
# DeepSeek:   https://platform.deepseek.com/  (推荐，OpenAI 兼容协议)
# OpenAI:     https://platform.openai.com/
AI_API_KEY=sk-your-api-key-here

# 大模型 API 地址（可选）
# DeepSeek 默认: https://api.deepseek.com/v1/chat/completions
# OpenAI 默认:   https://api.openai.com/v1/chat/completions
AI_API_URL=https://api.deepseek.com/v1/chat/completions

# 可信反向代理网段（逗号分隔，支持精确 IP 与 CIDR）
# 仅当直连方落在这些网段内时才采信 X-Forwarded-For / X-Real-IP，否则一律使用 TCP 源地址。
# 留空 = 不信任任何代理头（最安全）；Nginx/网关后部署请填网关网段，例如 10.0.0.0/8,172.17.0.0/16
TRUSTED_PROXIES=

# JWT 与 Webhook 接入密钥（生产必须覆盖，仓库默认值仅供演示）
JWT_SECRET=please-change-me-to-a-random-32-bytes-minimum
WEBHOOK_SECRET_KEY=please-change-me-webhook-token

# 模型名称（可选）
# DeepSeek: deepseek-chat
# OpenAI:   gpt-4o-mini
AI_MODEL=deepseek-chat

# ─── 企业级分布式与私有化扩展配置 (可选) ───
# Kafka 分布式流式摄取削峰 (docker compose --profile enterprise 模式)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=audit.logs.raw

# ClickHouse 列式 OLAP 45x 毫秒直方图引擎
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123/default

# Ollama 本地私有化大模型 (100% 本地离线私有化)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
